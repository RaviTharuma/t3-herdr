{
  "name": "t3-herdr",
  "version": "0.2.0",
  "type": "module",
  "description": "Installable Herdr whole-environment host for compatible T3 releases.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/server.js",
    "./runner": "./dist/runner.js"
  },
  "bin": {
    "t3-herdr": "./dist/cli.js",
    "t3-herdr-runner": "./dist/runner.js",
    "t3-herdr-host": "./dist/t3-herdr-host"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "prepack": "bun run check",
    "build:darwin-arm64": "bun scripts/build.ts darwin-arm64",
    "build:linux-x64": "bun scripts/build.ts linux-x64"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
